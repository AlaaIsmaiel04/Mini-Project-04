{
  "name": "smartshelf",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "postinstall": "npm run build -w @smartshelf/contracts",
    "dev": "concurrently -k -n api,web \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev -w @smartshelf/api",
    "dev:web": "npm run dev -w @smartshelf/web",
    "build": "npm run build -w @smartshelf/contracts && npm run build -w @smartshelf/api && npm run build -w @smartshelf/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "smoke": "node scripts/smoke.mjs",
    "db:generate": "npm run db:generate -w @smartshelf/api",
    "db:migrate": "npm run db:migrate -w @smartshelf/api",
    "db:deploy": "npm run db:deploy -w @smartshelf/api",
    "db:studio": "npm run db:studio -w @smartshelf/api",
    "format": "prettier --write \"{apps,packages}/**/*.{ts,tsx,css,json}\" \"docs/**/*.md\" README.md",
    "format:check": "prettier --check \"{apps,packages}/**/*.{ts,tsx,css,json}\" \"docs/**/*.md\" README.md",
   "pretypecheck": "npm run db:generate",
   "pretest": "npm run db:generate"
    },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0"
  },
  "allowScripts": {
    "@prisma/engines": true,
    "prisma": true,
    "@prisma/client": true
  }
}
