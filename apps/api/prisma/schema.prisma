generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  PHARMACIST
}

model Account {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String
  role         Role
  pharmacyId   String?   @db.Uuid
  pharmacy     Pharmacy? @relation(fields: [pharmacyId], references: [id], onDelete: Restrict)
}

model Pharmacy {
  id                 String        @id @default(uuid()) @db.Uuid
  name               String
  area               String
  address            String
  phone              String
  inventoryUpdatedAt DateTime?     @db.Timestamptz(3)
  accounts           Account[]
  subscription       Subscription?
  medicines          Medicine[]
  dutyPeriods        DutyPeriod[]
}

model Subscription {
  id         String   @id @default(uuid()) @db.Uuid
  pharmacyId String   @unique @db.Uuid
  startDate  DateTime @db.Date
  endDate    DateTime @db.Date
  suspended  Boolean  @default(false)
  pharmacy   Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Restrict)
}

model Medicine {
  id               String   @id @default(uuid()) @db.Uuid
  pharmacyId       String   @db.Uuid
  displayName      String
  normalizedName   String
  scientificName   String
  category         String
  reorderThreshold Float    @default(0)
  pharmacy         Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Restrict)
  batches          Batch[]

  @@unique([pharmacyId, normalizedName])
}

model Batch {
  id              String   @id @default(uuid()) @db.Uuid
  medicineId      String   @db.Uuid
  batchNumber     String
  quantity        Int
  expiryDate      DateTime @db.Date
  storageLocation String
  unitCost        Decimal  @db.Decimal(12, 2)
  barcode         String?
  medicine        Medicine @relation(fields: [medicineId], references: [id], onDelete: Restrict)

  @@unique([medicineId, batchNumber])
}

model DutyPeriod {
  id         String   @id @default(uuid()) @db.Uuid
  pharmacyId String   @db.Uuid
  startsAt   DateTime @db.Timestamptz(3)
  endsAt     DateTime @db.Timestamptz(3)
  pharmacy   Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Restrict)

  @@index([pharmacyId, startsAt])
}
